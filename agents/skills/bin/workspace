#!/usr/bin/env ruby
# frozen_string_literal: true

require "optparse"
require "fileutils"
require "date"
require "pathname"
require "shellwords"
require "json"

module Workspace

  WORKSPACES_DIR = File.expand_path("~/Code/workspaces")
  TEMPLATE_DIR   = File.expand_path("../../templates/workspace", __dir__)
  MEMORY_LOG_DIR = File.expand_path("~/Code/memory/log")
  # Outside the git-tracked memory store: artifacts can hold user data.
  ARCHIVE_DIR    = File.expand_path("~/Code/archive")
  IGNORED_LOOSE  = %w[.DS_Store].freeze
  NAME_PATTERN   = /\A[A-Za-z0-9._-]+\z/
  STUB_SUMMARY   = "_Filled in when the workspace is completed._"

  class Error < StandardError
    def kind = "error"
  end

  class UsageError       < Error; def kind = "invalid_argument"; end
  class NotFoundError    < Error; def kind = "not_found";        end
  class DuplicateError   < Error; def kind = "duplicate";         end
  class DirtyWorktreeError < Error; def kind = "dirty_worktree"; end
  class EmptySummaryError  < Error; def kind = "empty_summary";  end
  class GitError           < Error; def kind = "git_error";       end
  class LooseFilesError    < Error; def kind = "loose_files";     end

  # Inspects a single git worktree path. All accessors shell out to git; values
  # are reasonably cheap to recompute, so no memoization.
  class Worktree
    attr_reader :path, :workspace

    def initialize(path, workspace)
      @path = path
      @workspace = workspace
    end

    # e.g. "acme/widgets"
    def slug
      Pathname.new(path).relative_path_from(Pathname.new(workspace.worktrees_dir)).to_s
    end

    def branch
      out = git("rev-parse", "--abbrev-ref", "HEAD")
      out.empty? ? nil : out
    end

    def upstream
      # No upstream configured makes rev-parse exit 128; that's a normal state
      # (e.g. a branch whose remote was deleted after merge), not an error.
      out = git("rev-parse", "--abbrev-ref", "HEAD@{upstream}", allow_failure: true)
      out.empty? ? nil : out
    end

    # Returns [ahead, behind] vs. upstream, or [0, 0] if no upstream.
    def ahead_behind
      ref = upstream
      return [0, 0] unless ref
      out = git("rev-list", "--left-right", "--count", "HEAD...#{ref}")
      return [0, 0] if out.empty?
      a, b = out.split(/\s+/).map(&:to_i)
      [a || 0, b || 0]
    end

    def dirty?
      out = git("status", "--porcelain", "--ignore-submodules=none")
      !out.empty?
    rescue GitError => e
      raise DirtyWorktreeError, "git status failed for #{path}: #{e.message}"
    end

    def last_commit
      out = git("log", "-1", "--pretty=format:%h %s")
      out.empty? ? nil : out
    end

    private

    def git(*args, allow_failure: false)
      out = IO.popen(["git", "-C", path, *args], err: File::NULL, &:read).to_s
      unless $?.success?
        return "" if allow_failure
        raise GitError, "git #{args.first} failed (exit #{$?.exitstatus}) in #{path}"
      end
      out.strip
    end
  end

  class Entry
    attr_reader :name

    def initialize(name)
      raise UsageError, "Invalid workspace name: #{name.inspect}" unless name.is_a?(String) && name.match?(NAME_PATTERN)
      @name = name
    end

    def path              = File.join(WORKSPACES_DIR, name)
    def workspace_md_path = File.join(path, "WORKSPACE.md")
    def worktrees_dir     = File.join(path, ".worktrees")
    def exist?            = File.exist?(path)

    # Top-level entries the template didn't create (directories count as one
    # entry), e.g. ["queries", "research"].
    def loose_entries
      return [] unless exist?
      template = Dir.exist?(TEMPLATE_DIR) ? Dir.children(TEMPLATE_DIR) : []
      (Dir.children(path) - template - IGNORED_LOOSE - [".worktrees"]).sort
    end

    def worktrees
      return [] unless Dir.exist?(worktrees_dir)
      Dir.glob(File.join(worktrees_dir, "*", "*"))
        .select { |p| File.directory?(p) }
        .sort
        .map { |p| Worktree.new(p, self) }
    end

    # :missing | :empty | :stub | :populated
    def workspace_md_state
      return :missing unless File.exist?(workspace_md_path)
      body = summary_body
      return :empty if body.nil? || body.empty?
      return :stub  if body == STUB_SUMMARY
      :populated
    end

    # Extract the content of the `## Summary` section (between the heading and
    # the next `## ` heading or EOF), stripped.
    def summary_body
      return nil unless File.exist?(workspace_md_path)
      lines = File.readlines(workspace_md_path)
      start_idx = lines.index { |l| l.match?(/\A##\s+Summary\s*$/i) }
      return nil unless start_idx
      body_lines = []
      lines.drop(start_idx + 1).each do |line|
        break if line.match?(/\A##\s+/)
        body_lines << line
      end
      body_lines.join.strip
    end

    class << self
      def create(name)
        raise NotFoundError, "Template not found at #{TEMPLATE_DIR}" unless Dir.exist?(TEMPLATE_DIR)
        entry = new(name)
        raise DuplicateError, "Workspace '#{name}' already exists at #{entry.path}" if entry.exist?
        FileUtils.cp_r(TEMPLATE_DIR, entry.path)
        entry
      end

      def all
        return [] unless Dir.exist?(WORKSPACES_DIR)
        Dir.children(WORKSPACES_DIR)
          .reject { |n| n.start_with?(".") }
          .select { |n| n.match?(NAME_PATTERN) && File.directory?(File.join(WORKSPACES_DIR, n)) }
          .sort
          .map { |n| new(n) }
      end
    end
  end

  # Which tool to launch in the workspace, and how to seed it with an initial
  # prompt. The editor is always explicit (`--editor`): nothing is inferred
  # from the calling session, so a seeded handoff lands where you said it
  # should, on any box. Two kinds of value:
  #   - a shell command (`claude`, `opencode`, `vim`) — launched in a tmux window
  #   - `paseo` — launched as an agent through the Paseo daemon (module Paseo)
  module Editor
    module_function

    def resolve(explicit)
      value = explicit.to_s.strip
      raise UsageError, "--editor is required (e.g. claude, opencode, paseo)" if value.empty?
      value
    end

    def paseo?(editor)
      File.basename(editor.to_s.split(/\s/).first.to_s) == "paseo"
    end

    # Build the shell command that launches `editor`, optionally seeded with an
    # initial `prompt`. Tools differ in how they take a seed:
    #   - claude:   bare positional  ->  claude "…"
    #   - opencode: --prompt flag    ->  opencode --prompt "…"
    # Unknown tools fall back to the positional form.
    def command(editor, prompt = nil)
      return editor if prompt.nil? || prompt.empty?
      seed = Shellwords.escape(prompt)
      base = File.basename(editor.to_s.split(/\s/).first.to_s)
      case base
      when "opencode"
        "#{editor} --prompt #{seed}"
      else
        "#{editor} #{seed}"
      end
    end
  end

  module Tmux
    module_function

    def window_exists?(name)
      out = IO.popen(["tmux", "list-windows", "-F", '#{window_name}'], err: File::NULL, &:read).to_s
      return false unless $?.success?
      out.split("\n").include?(name)
    end

    # `prompt`, when present, seeds the launched tool with an initial input via
    # the tool-specific form (see Editor.command) — e.g. `claude "Read
    # ./BRIEF.md ..."` or `opencode --prompt "…"`. It only applies to a freshly
    # opened window; an already-existing window is just selected, since its
    # session is live.
    def open(name, cwd, editor, prompt = nil)
      if window_exists?(name)
        system("tmux", "select-window", "-t", name)
      else
        cmd = Editor.command(editor, prompt)
        ok = system("tmux", "new-window", "-n", name, "-c", cwd, cmd)
        return ok unless ok
        # Split off a bottom pane running a plain shell in the workspace cwd,
        # then return focus to the editor pane on top.
        system("tmux", "split-window", "-v", "-l", "30%", "-t", name, "-c", cwd)
        system("tmux", "select-pane", "-t", name, "-U")
      end
    end

    def kill(name)
      system("tmux", "kill-window", "-t", name, out: File::NULL, err: File::NULL)
    end
  end

  # The Paseo daemon as a session surface. A workspace folder maps to one Paseo
  # workspace (local isolation, cwd = the folder); `open` launches one agent
  # there from a named agent profile in ~/.paseo/config.json. Everything goes
  # through the `paseo` CLI — nothing here touches Paseo's registry files.
  module Paseo
    module_function

    CONFIG_PATH = File.expand_path(ENV.fetch("WORKSPACE_PASEO_CONFIG", "~/.paseo/config.json"))
    PROFILE     = "Architect"
    STUB_PROMPT = "Read ./WORKSPACE.md and wait for instructions."

    def cli(*args, chdir: nil)
      argv = ["paseo", *args, "--json"]
      popen_opts = { err: File::NULL }
      popen_opts[:chdir] = chdir if chdir
      out = IO.popen(argv, popen_opts, &:read).to_s
      raise Error, "paseo #{args.first} failed (exit #{$?.exitstatus})" unless $?.success?
      JSON.parse(out)
    rescue Errno::ENOENT
      raise Error, "paseo CLI not found on PATH"
    rescue JSON::ParserError
      raise Error, "paseo #{args.first} returned non-JSON output"
    end

    def find_workspace(cwd)
      cli("workspace", "ls").find { |w| w["cwd"] == cwd }
    end

    def ensure_workspace(name, cwd)
      find_workspace(cwd) ||
        cli("workspace", "create", "--isolation", "local", "--path", cwd, "--title", name)
    end

    # List globally and filter by path ourselves: `paseo ls` scoped to a
    # directory with no agents falls back to listing every agent, and its cwd
    # field is tilde-abbreviated.
    def live_agent?(cwd)
      cli("ls", "--global").any? do |a|
        a["status"] != "closed" && File.expand_path(a["cwd"].to_s) == cwd
      end
    end

    def profile(name = PROFILE)
      config = JSON.parse(File.read(CONFIG_PATH))
      found = Array(config.dig("daemon", "agentProfiles")).find { |p| p["name"] == name }
      raise Error, "agent profile #{name.inspect} not found in #{CONFIG_PATH}" unless found
      found
    rescue Errno::ENOENT
      raise Error, "Paseo config not found at #{CONFIG_PATH}"
    end

    # Materialize a profile into `paseo run` flags (the CLI has no --profile).
    def run_flags(profile)
      flags = ["--provider", [profile["provider"], profile["model"]].compact.join("/")]
      flags += ["--mode", profile["modeId"]] if profile["modeId"]
      flags += ["--thinking", profile["thinkingOptionId"]] if profile["thinkingOptionId"]
      flags
    end

    # :existing when the workspace already has a live agent (mirrors tmux's
    # select-if-exists: a running session is never re-seeded), else :launched.
    def open(name, cwd, prompt = nil)
      ws = ensure_workspace(name, cwd)
      return :existing if live_agent?(cwd)
      seed = prompt.to_s.empty? ? STUB_PROMPT : prompt
      cli("run", "--background", "--workspace", ws["workspaceId"], "--title", name,
          *run_flags(profile), seed)
      :launched
    end

    # Idempotent, like Tmux.kill: true if a registered workspace was archived,
    # false if there was none or Paseo is unavailable on this box. Registering
    # a folder makes Paseo create a project rooted on that folder; archiving the
    # workspace leaves it behind, so the project rooted exactly on the folder
    # is deleted too (a project rooted elsewhere, e.g. ~/Code, is left alone).
    def archive(cwd)
      ws = find_workspace(cwd)
      return false unless ws
      cli("workspace", "archive", ws["workspaceId"])
      project = cli("project", "ls").find { |p| p["path"] == cwd }
      cli("project", "delete", project["projectId"]) if project
      true
    rescue Error
      false
    end
  end

  class Destroyer
    attr_reader :entry

    def initialize(entry)
      @entry = entry
    end

    def plan
      preflight
      {
        worktrees: entry.worktrees.map { |wt| { slug: wt.slug, branch: wt.branch, dirty: wt.dirty? } },
        workspace_path: entry.path,
        tmux_window: entry.name,
      }
    end

    def run
      preflight
      preserved = entry.worktrees.map { |wt| { slug: wt.slug, branch: wt.branch } }
      remove_worktrees_force
      paseo_archived = Paseo.archive(entry.path)
      FileUtils.rm_rf(entry.path)
      Tmux.kill(entry.name)
      { preserved: preserved, paseo_archived: paseo_archived }
    end

    private

    def preflight
      raise NotFoundError, "Workspace '#{entry.name}' not found at #{entry.path}" unless entry.exist?
    end

    def remove_worktrees_force
      entry.worktrees.each do |wt|
        ok = system("git", "-C", wt.path, "worktree", "remove", "--force", wt.path)
        raise Error, "git worktree remove --force failed for #{wt.slug}" unless ok
      end
    end
  end

  class Completer
    attr_reader :entry, :date, :log_dest, :archive_dest, :keep, :discard_loose

    def initialize(entry, date: Date.today, keep: [], discard_loose: false)
      @entry = entry
      @date  = date
      @log_dest = File.join(MEMORY_LOG_DIR, "#{date.iso8601}-#{entry.name}.md")
      @archive_dest = File.join(ARCHIVE_DIR, "#{date.iso8601}-#{entry.name}")
      @keep = keep.map { |k| Pathname.new(k).cleanpath.to_s }
      @discard_loose = discard_loose
    end

    def plan
      preflight
      {
        worktrees: snapshot_worktrees,
        log_dest: log_dest,
        keep: keep,
        archive_dest: keep.empty? ? nil : archive_dest,
        discard: unkept_loose,
        workspace_path: entry.path,
        tmux_window: entry.name,
      }
    end

    def run
      preflight
      preserved = snapshot_worktrees
      remove_worktrees
      archive_kept
      move_workspace_md
      paseo_archived = Paseo.archive(entry.path)
      remove_workspace
      Tmux.kill(entry.name)
      { log_dest: log_dest, preserved: preserved, paseo_archived: paseo_archived,
        archive_dest: keep.empty? ? nil : archive_dest, kept: keep }
    end

    private

    # Loose entries not archived whole by a --keep path.
    def unkept_loose
      entry.loose_entries - keep
    end

    def snapshot_worktrees
      entry.worktrees.map { |wt| { slug: wt.slug, branch: wt.branch, upstream: wt.upstream } }
    end

    def preflight
      raise NotFoundError, "Workspace '#{entry.name}' not found at #{entry.path}" unless entry.exist?

      case entry.workspace_md_state
      when :missing
        raise UsageError, "Workspace has no WORKSPACE.md at #{entry.workspace_md_path}"
      when :empty, :stub
        raise EmptySummaryError, "WORKSPACE.md `## Summary` is #{entry.workspace_md_state}; fill it in before completing"
      end

      raise DuplicateError, "Log already exists at #{log_dest}" if File.exist?(log_dest)

      keep.each do |k|
        if k.start_with?("/", "..") || k == "." || !File.exist?(File.join(entry.path, k))
          raise UsageError, "--keep path not found inside the workspace: #{k}"
        end
        if k == "WORKSPACE.md" || k == ".worktrees" || k.start_with?(".worktrees/")
          raise UsageError, "--keep can't archive #{k}"
        end
      end
      raise DuplicateError, "Archive already exists at #{archive_dest}" if keep.any? && File.exist?(archive_dest)
      if unkept_loose.any? && !discard_loose
        raise LooseFilesError, "Loose files would be deleted: #{unkept_loose.join(", ")}. " \
          "Archive them with --keep <path> or pass --discard-loose"
      end

      dirty = entry.worktrees.select(&:dirty?)
      return if dirty.empty?
      raise DirtyWorktreeError, "Uncommitted changes in worktree(s): #{dirty.map(&:slug).join(", ")}"
    end

    # --force because plain `git worktree remove` refuses any worktree with
    # initialized submodules, even a clean one. Safe: preflight already
    # rejected dirty worktrees, and dirty? overrides submodule ignore config.
    def remove_worktrees
      entry.worktrees.each do |wt|
        ok = system("git", "-C", wt.path, "worktree", "remove", "--force", wt.path)
        raise Error, "git worktree remove failed for #{wt.slug}" unless ok
      end
    end

    def archive_kept
      keep.each do |k|
        dest = File.join(archive_dest, k)
        FileUtils.mkdir_p(File.dirname(dest))
        FileUtils.mv(File.join(entry.path, k), dest)
      end
    end

    def move_workspace_md
      FileUtils.mkdir_p(MEMORY_LOG_DIR)
      FileUtils.mv(entry.workspace_md_path, log_dest)
      return if keep.empty?
      File.open(log_dest, "a") do |f|
        f.puts "", "## Artifacts", "", "Archived to `#{archive_dest}` (not git-tracked):"
        keep.each { |k| f.puts "- `#{k}`" }
      end
    end

    def remove_workspace
      FileUtils.rm_rf(entry.path)
    end
  end
end


class Application
  def create(name:, open: false, editor: nil, prompt: nil)
    entry = Workspace::Entry.create(name)
    puts "Created workspace: #{entry.path}"
    open(name: name, editor: editor, prompt: prompt) if open
  end

  def open(name:, editor:, prompt: nil)
    entry = Workspace::Entry.new(name)
    raise Workspace::NotFoundError, "Workspace '#{name}' not found at #{entry.path}" unless entry.exist?
    resolved = Workspace::Editor.resolve(editor)
    if Workspace::Editor.paseo?(resolved)
      case Workspace::Paseo.open(name, entry.path, prompt)
      when :existing then puts "Paseo workspace '#{name}' already has a live agent; nothing launched"
      when :launched then puts "Launched Paseo agent in workspace '#{name}'"
      end
    else
      ok = Workspace::Tmux.open(name, entry.path, resolved, prompt)
      raise Workspace::Error, "tmux command failed (is tmux running?)" unless ok
    end
  end

  def status(name:)
    entry = Workspace::Entry.new(name)
    raise Workspace::NotFoundError, "Workspace '#{name}' not found at #{entry.path}" unless entry.exist?

    puts "Workspace: #{entry.name}"
    puts "  Path:      #{entry.path}"
    puts "  WORKSPACE.md:  #{entry.workspace_md_state}"
    puts "  Loose files:   #{entry.loose_entries.empty? ? "(none)" : entry.loose_entries.join(", ")}"
    puts "  Worktrees:"
    wts = entry.worktrees
    if wts.empty?
      puts "    (none)"
      return
    end
    wts.each do |wt|
      ahead, behind = wt.ahead_behind
      flags = []
      flags << "dirty" if wt.dirty?
      flags << "+#{ahead}/-#{behind}" if (ahead + behind) > 0
      flags << "no upstream" if wt.upstream.nil?
      flag_s = flags.empty? ? "clean" : flags.join(", ")
      puts "    #{wt.slug}"
      puts "      branch:    #{wt.branch || "—"}"
      puts "      upstream:  #{wt.upstream || "—"}"
      puts "      state:     #{flag_s}"
      puts "      last:      #{wt.last_commit || "—"}"
    end
  end

  def list
    entries = Workspace::Entry.all
    if entries.empty?
      puts "No workspaces."
      return
    end
    rows = entries.map do |e|
      wts = e.worktrees
      dirty = wts.count(&:dirty?)
      ready =
        if e.workspace_md_state != :populated
          "no (doc #{e.workspace_md_state})"
        elsif dirty > 0
          "no (#{dirty} dirty)"
        elsif e.loose_entries.any?
          "no (#{e.loose_entries.size} loose; review first)"
        else
          "yes"
        end
      [e.name, wts.size.to_s, e.workspace_md_state.to_s, ready]
    end
    headers = ["NAME", "WORKTREES", "WORKSPACE.md", "READY"]
    widths = headers.each_with_index.map { |h, i| ([h, *rows.map { |r| r[i] }].map(&:length).max) }
    fmt = widths.map { |w| "%-#{w}s" }.join("  ")
    puts(fmt % headers)
    rows.each { |r| puts(fmt % r) }
  end

  def destroy(name:, dry_run: false)
    entry = Workspace::Entry.new(name)
    destroyer = Workspace::Destroyer.new(entry)

    if dry_run
      plan = destroyer.plan
      puts "Dry-run destroy for workspace '#{name}':"
      puts "  Worktrees to force-remove:"
      if plan[:worktrees].empty?
        puts "    (none)"
      else
        plan[:worktrees].each do |wt|
          dirty_s = wt[:dirty] ? " [DIRTY: uncommitted changes will be discarded]" : ""
          puts "    #{wt[:slug]}  (branch: #{wt[:branch] || "—"})#{dirty_s}"
        end
      end
      puts "  Will rm -rf:       #{plan[:workspace_path]}"
      puts "  Will close tmux:   #{plan[:tmux_window]} (if exists)"
      puts "  Will archive Paseo workspace at #{plan[:workspace_path]} (if registered)"
      return
    end

    result = destroyer.run
    puts "Destroyed workspace '#{name}'"
    puts "  Archived Paseo workspace" if result[:paseo_archived]
    if result[:preserved].any?
      puts "  Branches preserved (uncommitted changes discarded):"
      result[:preserved].each do |wt|
        puts "    #{wt[:slug]}: #{wt[:branch] || "—"}"
      end
    end
  end

  def complete(name:, dry_run: false, keep: [], discard_loose: false)
    entry = Workspace::Entry.new(name)
    completer = Workspace::Completer.new(entry, keep: keep, discard_loose: discard_loose)

    if dry_run
      plan = completer.plan
      puts "Dry-run for workspace '#{name}':"
      puts "  Worktrees to remove:"
      if plan[:worktrees].empty?
        puts "    (none)"
      else
        plan[:worktrees].each do |wt|
          puts "    #{wt[:slug]}  (branch: #{wt[:branch] || "—"}, upstream: #{wt[:upstream] || "—"})"
        end
      end
      puts "  Archive destination: #{plan[:log_dest]}"
      plan[:keep].each { |k| puts "  Will archive:      #{k} -> #{File.join(plan[:archive_dest], k)}" }
      plan[:discard].each { |d| puts "  Will delete loose: #{d}" }
      puts "  Will rm -rf:       #{plan[:workspace_path]}"
      puts "  Will close tmux:   #{plan[:tmux_window]} (if exists)"
      puts "  Will archive Paseo workspace at #{plan[:workspace_path]} (if registered)"
      return
    end

    result = completer.run
    puts "Completed workspace '#{name}'"
    puts "  Archived: #{result[:log_dest]}"
    puts "  Artifacts: #{result[:kept].join(", ")} -> #{result[:archive_dest]}" if result[:archive_dest]
    puts "  Archived Paseo workspace" if result[:paseo_archived]
    if result[:preserved].any?
      puts "  Branches preserved:"
      result[:preserved].each do |wt|
        upstream_s = wt[:upstream] ? "tracking #{wt[:upstream]}" : "local only"
        puts "    #{wt[:slug]}: #{wt[:branch] || "—"} (#{upstream_s})"
      end
    end
  end
end


return unless __FILE__ == $PROGRAM_NAME

parser = OptionParser.new do |opts|
  opts.banner = <<~BANNER
    Usage: workspace <command> [args]

    Commands:
      create   --name <name>              Create a new workspace from the template
        (alias: new) [--open --editor <e>]  (--open requires --editor)
      open     --name <name> --editor <e> Open the workspace: a tmux window running <e>,
                                          or a Paseo agent when <e> is `paseo`
      status   --name <name>              Show worktree and WORKSPACE.md state
      list                                List workspaces with summary state
      complete --name <name> [--dry-run]  Tear down a finished workspace
               [--keep <path>]... [--discard-loose]
      destroy  --name <name> [--dry-run]  Force-remove a workspace (skip doc/memory flow)

  BANNER
  opts.on("-h", "--help", "Show this help") { puts opts; exit 0 }
end
parser.order!(ARGV)

if ARGV.empty?
  puts parser
  exit 0
end

cmd = ARGV.shift
app = Application.new

begin
  case cmd
  when "create", "new"
    opts = { name: nil, open: false, editor: nil, prompt: nil }
    OptionParser.new do |o|
      o.banner = "Usage: workspace #{cmd} --name <name> [--open --editor <cmd|paseo> [--prompt <text>]]"
      o.on("--name=NAME", "Workspace name") { |v| opts[:name] = v }
      o.on("--open", "Open the workspace after creating (requires --editor)") { opts[:open] = true }
      o.on("--editor=CMD", "Tool to launch: a command for a tmux window (claude, opencode, vim) or `paseo`") { |v| opts[:editor] = v }
      o.on("--prompt=TEXT", "Initial input to seed the tool with (fresh session only)") { |v| opts[:prompt] = v }
    end.parse!(ARGV)
    raise Workspace::UsageError, "#{cmd} requires --name" if opts[:name].nil? || opts[:name].empty?
    raise Workspace::UsageError, "--open requires --editor (e.g. claude, opencode, paseo)" if opts[:open] && opts[:editor].to_s.strip.empty?
    app.create(**opts)
  when "open"
    opts = { name: nil, editor: nil, prompt: nil }
    OptionParser.new do |o|
      o.banner = "Usage: workspace open --name <name> --editor <cmd|paseo> [--prompt <text>]"
      o.on("--name=NAME", "Workspace name") { |v| opts[:name] = v }
      o.on("--editor=CMD", "Tool to launch: a command for a tmux window (claude, opencode, vim) or `paseo`") { |v| opts[:editor] = v }
      o.on("--prompt=TEXT", "Initial input to seed the tool with (fresh session only)") { |v| opts[:prompt] = v }
    end.parse!(ARGV)
    raise Workspace::UsageError, "open requires --name" if opts[:name].nil? || opts[:name].empty?
    app.open(**opts)
  when "status"
    opts = { name: nil }
    OptionParser.new do |o|
      o.banner = "Usage: workspace status --name <name>"
      o.on("--name=NAME", "Workspace name") { |v| opts[:name] = v }
    end.parse!(ARGV)
    raise Workspace::UsageError, "status requires --name" if opts[:name].nil? || opts[:name].empty?
    app.status(**opts)
  when "list"
    OptionParser.new { |o| o.banner = "Usage: workspace list" }.parse!(ARGV)
    app.list
  when "complete"
    opts = { name: nil, dry_run: false, keep: [], discard_loose: false }
    OptionParser.new do |o|
      o.banner = "Usage: workspace complete --name <name> [--dry-run] [--keep <path>]... [--discard-loose]"
      o.on("--name=NAME", "Workspace name") { |v| opts[:name] = v }
      o.on("--dry-run", "Show what would happen without modifying anything") { opts[:dry_run] = true }
      o.on("--keep=PATH", "Archive this workspace-relative path to #{Workspace::ARCHIVE_DIR}/<date>-<name>/ (repeatable)") { |v| opts[:keep] << v }
      o.on("--discard-loose", "Allow deleting loose files not archived with --keep") { opts[:discard_loose] = true }
    end.parse!(ARGV)
    raise Workspace::UsageError, "complete requires --name" if opts[:name].nil? || opts[:name].empty?
    app.complete(**opts)
  when "destroy"
    opts = { name: nil, dry_run: false }
    OptionParser.new do |o|
      o.banner = "Usage: workspace destroy --name <name> [--dry-run]"
      o.on("--name=NAME", "Workspace name") { |v| opts[:name] = v }
      o.on("--dry-run", "Show what would happen without modifying anything") { opts[:dry_run] = true }
    end.parse!(ARGV)
    raise Workspace::UsageError, "destroy requires --name" if opts[:name].nil? || opts[:name].empty?
    app.destroy(**opts)
  else
    raise Workspace::UsageError, "Unknown command: #{cmd}. Run `workspace --help` for usage."
  end

  exit 0
rescue => e
  warn "[ERROR] #{e.message}"
  exit 1
end
